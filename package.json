{
  "name": "firebase-water",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-postgres-env.mjs && prisma generate && next dev",
    "dev:env": "node scripts/ensure-postgres-env.mjs",
    "build": "node scripts/prepare-db-env.mjs && prisma generate && next build",
    "build:with-migrate": "node scripts/prepare-db-env.mjs && prisma generate && prisma migrate deploy && next build",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:apply-vat": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/20260530120000_vat_settings/migration.sql",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test __tests__/*.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx prisma/seed.ts",
    "db:seed-test-residents": "tsx scripts/seed-test-residents.ts",
    "db:studio": "prisma studio",
    "mcp:upload": "node scripts/mcp-image-upload.mjs",
    "test:hoadon": "node scripts/test-hoadon-webhook.mjs",
    "firebase:secrets": "node scripts/firebase-set-secrets.mjs",
    "firebase:create-db-user": "node scripts/firebase-create-db-user.mjs",
    "firebase:wire-cloudsql": "node scripts/firebase-wire-cloudsql.mjs",
    "firebase:grant-db": "node scripts/firebase-grant-db-iam.mjs",
    "firebase:deploy-apphosting": "npx -y firebase-tools@latest deploy --only apphosting",
    "firebase:deploy-production": "npm run firebase:deploy-apphosting && npm run firebase:wire-cloudsql && npm run firebase:deploy-hosting",
    "firebase:post-deploy": "npm run firebase:wire-cloudsql",
    "firebase:copy-db": "node scripts/firebase-copy-db.mjs",
    "firebase:cloudsql-url": "node scripts/firebase-cloudsql-url.mjs",
    "firebase:provision-auth": "tsx scripts/firebase-provision-auth.mjs",
    "db:set-password": "tsx scripts/set-user-password.ts",
    "db:import-real-water-data": "node scripts/import-real-water-data.mjs",
    "firebase:migrate-subset": "node scripts/migrate-subset-to-tiennuoc.mjs",
    "firebase:seed-demo": "tsx scripts/seed-tiennuoc-demo.mjs",
    "firebase:seed-mock-50": "tsx scripts/seed-mock-50.ts",
    "db:update-addresses-haiphong": "tsx scripts/update-addresses-haiphong.mjs",
    "db:reshape-mock-periods": "tsx scripts/reshape-mock-periods.ts",
    "db:refresh-pending-old-readings": "tsx scripts/refresh-pending-old-readings.ts",
    "db:backfill-invoice-vat": "tsx scripts/backfill-invoice-vat.ts",
    "db:audit": "tsx scripts/db-audit.ts",
    "db:dedupe-names": "tsx scripts/dedupe-resident-names.ts",
    "dataconnect:generate": "npx -y firebase-tools@latest dataconnect:sdk:generate",
    "dataconnect:deploy": "npx -y firebase-tools@latest deploy --only dataconnect",
    "firebase:deploy-hosting": "npx -y firebase-tools@latest deploy --only hosting",
    "firebase:emulators:hosting": "npx -y firebase-tools@latest emulators:start --only hosting",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@fontsource/be-vietnam-pro": "^5.2.8",
    "@fontsource/roboto-mono": "^5.2.9",
    "@google-cloud/cloud-sql-connector": "^1.11.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^6.19.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.1",
    "typescript": "^5"
  }
}
